PORT=3000
FRONTEND_URL=https://proyecta-mining.pages.dev
PUBLIC_APP_URL=https://proyecta-mining.pages.dev
PASSWORD_RESET_BASE_URL=https://proyecta-mining.pages.dev
PASSWORD_RESET_TTL_MINUTES=60
ORCID_BASE_URL=https://orcid.org
ORCID_API_BASE_URL=https://pub.orcid.org
ORCID_REDIRECT_URI=https://proyecta-production-c6d6.up.railway.app/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Monero RPC Endpoint
# Local: http://localhost:18081 (requires local monerod)
# Remote: https://node.moneroworld.com:18089
MONERO_RPC_HOST=https://node.moneroworld.com:18089

# RPC Authentication (optional if using public node)
MONERO_RPC_USER=
MONERO_RPC_PASS=

# BIP-39 Master Seed for deterministic address generation
# SECURITY: Store in Railway Secrets, NOT in version control
# Generate with: monerod --restore-deterministic-wallet
MONERO_MASTER_SEED=

# SMTP opcional para envio real de enlaces de recuperacion
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PROYECTA <no-reply@proyecta.org>"

# Solo para pruebas locales. No lo habilites en produccion.
ENABLE_PASSWORD_RESET_PREVIEW=false
